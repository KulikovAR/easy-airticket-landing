---
import { postPath } from '../data/routes';
import { t } from '../data/site';
import type { Lang } from '../data/i18n';
import { formatDate, type Post } from '../data/posts';

interface Props { post: Post; lang: Lang }
const { post, lang } = Astro.props;
const ui = t(lang);
const text = post[lang]!;
const PLANE = 'M21 16v-2l-8-5V3.5a1.5 1.5 0 0 0-3 0V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z';
const ART = {
  ticket: 'M22 10V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v4a2 2 0 1 1 0 4v4a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-4a2 2 0 1 1 0-4zm-9 7.5h-2v-2h2v2zm0-4.5h-2v-2h2v2zm0-4.5h-2v-2h2v2z',
  pin: 'M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 0 1 0-5 2.5 2.5 0 0 1 0 5z',
};
---
<a class="post reveal" href={postPath(post, lang)}>
  <div class={`post__thumb post__thumb--${post.theme}`} aria-hidden="true">
    <div class="post__art">{post.flag ? <span class="post__flag">{post.flag}</span> : <svg viewBox="0 0 24 24"><path d={ART[post.art]}/></svg>}</div>
    <span class="post__more"><span>{ui.readMore}</span></span>
  </div>
  <h3 class="post__title">{text.title}</h3>
  <div class="post__meta">
    <span class="post__author"><span class="post__avatar" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={PLANE}/></svg></span>{ui.author}</span>
    {post.date && <time datetime={post.date}>{formatDate(post.date, lang)}</time>}
  </div>
</a>
