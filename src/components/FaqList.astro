---
import type { Faq } from '../data/types';
interface Props { items: Faq[]; title?: string }
const { items, title } = Astro.props;
---
<div class="faq">
  {title && <h2>{title}</h2>}
  {items.map((f, i) => (
    <details class="faq__item" open={i === 0}>
      <summary>{f.q}</summary>
      <p>{f.a}</p>
    </details>
  ))}
</div>
