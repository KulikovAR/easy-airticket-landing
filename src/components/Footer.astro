---
import { t } from '../data/site';
import { home } from '../data/home';
import { company } from '../data/company';
import { languages, url, type Lang } from '../data/i18n';
import { faqPath, landingPath, landingsIn } from '../data/routes';

interface Props { lang: Lang; alternates?: Partial<Record<Lang, string>> }
const { lang, alternates = {} } = Astro.props;
const ui = t(lang);
const f = ui.footer;
const homePath = url(lang);
const howId = (home[lang] ?? home.en!).how.id;
const countries = landingsIn(lang, 'country');
const cities = landingsIn(lang, 'city');
const cols = 2 + (countries.length ? 1 : 0) + (cities.length ? 1 : 0);
const PLANE = 'M21 16v-2l-8-5V3.5a1.5 1.5 0 0 0-3 0V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z';
---
<footer class="footer">
  <div class="container">
    <div class="footer__news">
      <h2 class="footer__title" set:html={f.title} />
      <div class="footer__form-wrap">
        <form class="footer__form" id="notify-form" novalidate>
          <input type="email" name="email" placeholder={f.emailPlaceholder} aria-label={f.emailLabel} autocomplete="email" required>
          <button type="submit">{f.notify}</button>
        </form>
        <p class="footer__caption" id="notify-msg" data-ok={f.thanks} aria-live="polite">{f.caption}</p>
      </div>
    </div>

    <div class="footer__grid" style={`--cols: ${cols}`}>
      <div class="footer__brand">
        <a class="logo" href={homePath}>
          <span class="logo__mark"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={PLANE}/></svg></span>
          {company.brand}
        </a>
        <p>{f.about}</p>
        <hr>
        <h4>{f.feeTitle}</h4>
        <p class="footer__small">{f.feeText}</p>
      </div>

      <nav class="footer__col" aria-label={f.service}>
        <h4>{f.service}</h4>
        <ul>
          <li><a href={`${homePath}#search`}>{f.searchFlights}</a></li>
          <li><a href={`${homePath}#${howId}`}>{f.howItWorks}</a></li>
          <li><a href={`${homePath}#blog`}>{ui.articles}</a></li>
          <li><a href={faqPath(lang)}>{f.faq}</a></li>
        </ul>
      </nav>

      {countries.length > 0 && (
        <nav class="footer__col" aria-label={f.countries}>
          <h4>{f.countries}</h4>
          <ul>{countries.map((l) => <li><a href={landingPath(l, lang)}>{l[lang]!.name}</a></li>)}</ul>
        </nav>
      )}

      {cities.length > 0 && (
        <nav class="footer__col" aria-label={f.cities}>
          <h4>{f.cities}</h4>
          <ul>{cities.map((l) => <li><a href={landingPath(l, lang)}>{l[lang]!.name}</a></li>)}</ul>
        </nav>
      )}

      <div class="footer__col">
        <h4>{f.contact}</h4>
        <p class="footer__small">{f.contactText}</p>
        {company.email && <a class="footer__mail" href={`mailto:${company.email}`}>{company.email}</a>}
      </div>
    </div>

    <div class="footer__bottom">
      <p>© 2026 {company.brand}. <strong>{f.rights}</strong></p>
      <ul class="footer__langs">
        {languages.filter((l) => l.enabled).map((l) => (
          <li><a href={alternates[l.code] ?? url(l.code)} hreflang={l.hreflang} lang={l.htmlLang} aria-current={l.code === lang ? 'true' : undefined}>{l.label}</a></li>
        ))}
      </ul>
      <a class="footer__top" href="#" aria-label={f.toTop}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5.5 5.5 12l1.4 1.4 4.1-4.1V19h2V9.3l4.1 4.1 1.4-1.4z"/></svg></a>
    </div>
    <p class="footer__disclaimer">{f.disclaimer}</p>
  </div>
</footer>
