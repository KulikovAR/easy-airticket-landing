---
import { ui, type Lang } from '../data/site';
import Breadcrumbs, { type Crumb } from './Breadcrumbs.astro';

interface Props {
  lang: Lang;
  h1: string;
  lead: string;
  search?: boolean;
  crumbs?: Crumb[];
  compact?: boolean;
}
const { lang, h1, lead, search = true, crumbs, compact = false } = Astro.props;
const t = ui[lang];
---
<section class:list={['hero', { 'hero--compact': compact }]}>
  <svg class="hero__plane" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 16v-2l-8-5V3.5a1.5 1.5 0 0 0-3 0V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"/></svg>
  <div class="container">
    {crumbs && <Breadcrumbs crumbs={crumbs} />}
    <h1>{h1}</h1>
    <p class="hero__lead">{lead}</p>

    {search && (
      <>
        <form class="search" id="search-form" autocomplete="off">
          <label class="field">
            <span class="field__label">{t.from}</span>
            <input type="text" name="from" placeholder={t.cityPlaceholder} readonly data-soon="from">
          </label>
          <label class="field">
            <span class="field__label">{t.to}</span>
            <input type="text" name="to" placeholder={t.cityPlaceholder} readonly data-soon="to">
          </label>
          <label class="field field--dates">
            <span class="field__label">{t.dates}</span>
            <input type="text" id="dates" name="dates" placeholder={t.datesPlaceholder}>
          </label>
          <button class="search__btn" type="submit">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15.5 14h-.79l-.28-.27A6.47 6.47 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
            {t.search}
          </button>
        </form>

        <ul class="hero__badges">
          {t.badges.map((b) => <li>{b}</li>)}
        </ul>
      </>
    )}
  </div>
</section>
