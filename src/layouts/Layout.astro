---
import '@fontsource-variable/inter';
import '../styles/global.css';
import { ui, type Lang } from '../data/site';
import { company } from '../data/company';
import { seo } from '../data/seo';
import { legalDocs } from '../data/legal';
import { legalPath, paths, type Alternates } from '../data/routes';
import Footer from '../components/Footer.astro';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  alternates?: Alternates;
  schema?: object[];
  noindex?: boolean;
}

const { lang, title, description, alternates, schema = [], noindex = false } = Astro.props;
const t = ui[lang];
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).href;
const home = paths.home[lang];

const ogImage = new URL(`/og/og-${lang}.png`, site).href;
const cookiePolicy = legalPath(legalDocs.find((d) => d.id === 'privacy')![lang].slug, lang);
const hasAnalytics = Boolean(seo.ga4Id || seo.yandexMetrikaId);
const consentText = {
  tr: { text: 'Sitemizi geliştirmek için analitik çerezler kullanıyoruz. Zorunlu çerezler her zaman aktiftir.', more: 'Çerez Politikası', accept: 'Kabul et', reject: 'Yalnızca zorunlu' },
  en: { text: 'We use analytics cookies to improve our website. Strictly necessary cookies are always on.', more: 'Cookie Policy', accept: 'Accept', reject: 'Necessary only' },
}[lang];

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: company.brand,
  url: company.website,
  inLanguage: ['tr-TR', 'en'],
};

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: company.brand,
  url: company.website,
  ...(company.legalName && { legalName: company.legalName }),
  ...(company.email && { email: company.email }),
  ...(company.phone && { telephone: company.phone }),
  ...(company.address && { address: company.address }),
};
---
<!DOCTYPE html>
<html lang={t.htmlLang}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  {noindex ? <meta name="robots" content="noindex"> : <link rel="canonical" href={canonical}>}
  {alternates && (
    <>
      <link rel="alternate" hreflang="tr" href={new URL(alternates.tr, site).href}>
      <link rel="alternate" hreflang="en" href={new URL(alternates.en, site).href}>
      <link rel="alternate" hreflang="x-default" href={new URL(alternates.tr, site).href}>
    </>
  )}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt">
  {seo.googleSiteVerification && <meta name="google-site-verification" content={seo.googleSiteVerification}>}
  {seo.yandexVerification && <meta name="yandex-verification" content={seo.yandexVerification}>}
  {seo.bingVerification && <meta name="msvalidate.01" content={seo.bingVerification}>}
  <meta name="theme-color" content="#0b2a5b">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content={company.brand}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:locale" content={t.ogLocale}>
  <meta property="og:locale:alternate" content={lang === 'tr' ? 'en_US' : 'tr_TR'}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content={title}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImage}>

  <script type="application/ld+json" set:html={JSON.stringify(website)} />
  <script type="application/ld+json" set:html={JSON.stringify(organization)} />
  {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
</head>
<body>

<header class="header">
  <div class="container header__inner">
    <a class="logo" href={home}>
      <span class="logo__mark"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 16v-2l-8-5V3.5a1.5 1.5 0 0 0-3 0V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"/></svg></span>
      {company.brand}
    </a>
    <nav class="nav" aria-label={t.navLabel}>
      <a href={`${home}#${lang === 'tr' ? 'ulkeler' : 'countries'}`}>{t.navCountries}</a>
      <a href={`${home}#${lang === 'tr' ? 'sehirler' : 'cities'}`}>{t.navCities}</a>
      <a href={paths.faq[lang]}>{t.navFaq}</a>
      <a href={paths.contact[lang]}>{t.navContact}</a>
    </nav>
    <nav class="lang" aria-label={t.langLabel}>
      <a href={alternates?.tr ?? paths.home.tr} hreflang="tr" lang="tr" aria-current={lang === 'tr' ? 'true' : undefined}>TR</a>
      <a href={alternates?.en ?? paths.home.en} hreflang="en" lang="en" aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
    </nav>
  </div>
</header>

<main>
  <slot />
</main>

<Footer lang={lang} />

{company.whatsapp && (
  <a class="wa-float" href={`https://wa.me/${company.whatsapp}`} rel="nofollow" aria-label="WhatsApp">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12.04 2a9.9 9.9 0 0 0-8.5 14.98L2 22l5.16-1.5A9.9 9.9 0 1 0 12.04 2zm5.8 14.13c-.25.7-1.44 1.33-2 1.38-.51.05-1 .24-3.35-.7-2.83-1.12-4.62-4.02-4.76-4.2-.14-.19-1.14-1.52-1.14-2.9s.72-2.06.98-2.34a1.03 1.03 0 0 1 .75-.35h.54c.17 0 .41-.07.64.49.25.58.83 2 .9 2.15.08.14.12.31.03.5-.1.18-.14.3-.28.46l-.42.49c-.14.14-.29.29-.12.57.16.28.73 1.2 1.57 1.95 1.08.96 1.99 1.26 2.27 1.4.28.14.45.12.61-.07.17-.19.7-.82.9-1.1.18-.28.37-.23.62-.14.25.1 1.62.77 1.9.9.28.15.46.22.53.34.07.12.07.68-.18 1.37z"/></svg>
  </a>
)}

<div class="modal" id="soon-modal" role="dialog" aria-modal="true" aria-labelledby="soon-title" aria-hidden="true">
  <div class="modal__box">
    <button class="modal__close" type="button" aria-label={t.close} data-close>×</button>
    <div class="modal__emoji" aria-hidden="true">🛠️</div>
    <h2 id="soon-title">{t.soonTitle}</h2>
    <p>{t.soonText}</p>
    <button class="search__btn" type="button" data-close>{t.ok}</button>
  </div>
</div>

{hasAnalytics && (
  <div class="consent" id="consent" data-ga4={seo.ga4Id} data-ym={seo.yandexMetrikaId} hidden>
    <p>{consentText.text} <a href={cookiePolicy}>{consentText.more}</a></p>
    <div class="consent__actions">
      <button type="button" class="consent__btn consent__btn--ghost" data-consent="necessary">{consentText.reject}</button>
      <button type="button" class="consent__btn" data-consent="all">{consentText.accept}</button>
    </div>
  </div>
)}

<script>
  import '../scripts/app';
  import '../scripts/consent';
</script>
</body>
</html>
