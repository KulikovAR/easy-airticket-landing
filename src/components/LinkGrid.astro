---
import { landingPath } from '../data/routes';
import type { Lang } from '../data/i18n';
import type { Landing } from '../data/types';

interface Props { items: Landing[]; lang: Lang }
const { items, lang } = Astro.props;
---
<div class="link-grid">
  {items.map((l) => (
    <a class="link-card" href={landingPath(l, lang)}>
      {l.flag && <span class="link-card__flag" aria-hidden="true">{l.flag}</span>}
      <span>{l[lang]!.name}</span>
      <span class="link-card__arrow" aria-hidden="true">→</span>
    </a>
  ))}
</div>
