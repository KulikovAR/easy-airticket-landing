---
import { price, type Lang } from '../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const p = price[lang].display;

// Material icons: search, assignment_ind, credit_card, mail
const icons = [
  'M15.5 14h-.79l-.28-.27A6.47 6.47 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z',
  'M19 3h-4.18C14.4 1.84 13.3 1 12 1s-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm0 4c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm6 12H6v-1.4c0-2 4-3.1 6-3.1s6 1.1 6 3.1V19z',
  'M20 4H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2zm0 14H4v-6h16v6zm0-10H4V6h16v2z',
  'M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z',
];

const text = {
  tr: {
    title: 'Nasıl çalışır?',
    lead: 'Vize başvurunuz için uçuş rezervasyonunu 4 adımda, birkaç dakikada ve tamamen online yapın.',
    step: 'Adım',
    steps: [
      ['Rotayı seçin', 'Şehirleri, tarihleri ve yolcu sayısını seçin; size uygun herhangi bir uçuşu rezerve edin.'],
      ['Bilgileri girin', 'Pasaport ve iletişim bilgilerinizi girin. Ad-soyad pasaporttaki gibi Latin harfleriyle yazılır.'],
      ['Ödemeyi yapın', `Bilet ücretini değil, yalnızca hizmet bedelini ödersiniz. Herhangi bir banka kartı geçerlidir.`],
      ['Belgeleri alın', 'PNR kodlu belgeler e-postanıza gelir. Yazdırıp vize başvurunuza ekleyin.'],
    ],
    facts: [
      ['30 dk', 'belgeler e-postanızda'],
      ['7 gün', 'rezervasyonun geçerlilik süresi'],
      [p, 'yalnızca hizmet bedeli'],
    ],
  },
  en: {
    title: 'How it works',
    lead: 'Get a flight reservation for your visa application in 4 steps — a few minutes, fully online.',
    step: 'Step',
    steps: [
      ['Choose a route', 'Pick the cities, dates and number of passengers, then reserve any flight that suits you.'],
      ['Enter your details', 'Add your passport and contact details. Names are written in Latin letters exactly as in the passport.'],
      ['Pay the fee', 'You pay only the service fee, not the ticket price. Any bank card is accepted.'],
      ['Get your documents', 'Documents with the PNR code arrive by email. Print them and add them to your visa file.'],
    ],
    facts: [
      ['30 min', 'documents in your inbox'],
      ['7 days', 'reservation validity'],
      [p, 'service fee only'],
    ],
  },
}[lang];
---
<section class="section how" id={lang === 'tr' ? 'nasil-calisir' : 'how-it-works'}>
  <div class="container">
    <h2>{text.title}</h2>
    <p class="section__lead">{text.lead}</p>

    <ol class="flow">
      {text.steps.map(([h, body], i) => (
        <li class="flow__item">
          <span class="flow__icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={icons[i]} /></svg></span>
          <span class="flow__step">{text.step} {i + 1}</span>
          <h3>{h}</h3>
          <p>{body}</p>
        </li>
      ))}
    </ol>

    <ul class="flow__facts">
      {text.facts.map(([value, label]) => (
        <li><strong>{value}</strong><span>{label}</span></li>
      ))}
    </ul>
  </div>
</section>
