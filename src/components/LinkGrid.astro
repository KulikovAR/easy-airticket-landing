---
import type { Landing } from '../data/types';
import type { Lang } from '../data/site';
import { landingPath } from '../data/routes';

interface Props { items: Landing[]; lang: Lang; exclude?: string }
const { items, lang, exclude } = Astro.props;
---
<ul class="cards">
  {items.filter((l) => l.id !== exclude).map((l) => (
    <li>
      <a class="card" href={landingPath(l[lang].slug, lang)}>
        <span class="card__icon" aria-hidden="true">{l.flag ?? '📍'}</span>
        <span class="card__name">{l[lang].name}</span>
        <span class="card__arrow" aria-hidden="true">→</span>
      </a>
    </li>
  ))}
</ul>
