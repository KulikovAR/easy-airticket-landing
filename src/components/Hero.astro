---
import Crumbs from './Crumbs.astro';
import { t, type Lang } from '../data/site';
import type { Crumb } from '../data/types';

interface Props { lang: Lang; h1: string; lead: string; crumbs?: Crumb[] }
const { lang, h1, lead, crumbs } = Astro.props;
const ui = t(lang);
const places = [
  { key: 'from', label: ui.from },
  { key: 'to', label: ui.to },
];
---
<section class="hero" id="search">
  <svg class="hero__plane" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 16v-2l-8-5V3.5a1.5 1.5 0 0 0-3 0V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"/></svg>
  <div class="container">
    {crumbs && <Crumbs crumbs={crumbs} />}
    <h1>{h1}</h1>
    <p class="hero__lead">{lead}</p>

    <form class="search" id="search-form" autocomplete="off">
      {places.map((p) => (
        <div class="field field--place" data-place={p.key} data-empty={ui.nothingFound}>
          <label class="field__label" for={p.key}>{p.label}</label>
          <input type="text" id={p.key} placeholder={ui.cityPlaceholder} autocomplete="off" spellcheck="false" role="combobox" aria-expanded="false" aria-autocomplete="list" aria-controls={`${p.key}-list`}>
          <input type="hidden" name={p.key}>
          <svg class="field__chevron" viewBox="0 0 16 16" aria-hidden="true"><path fill-rule="evenodd" d="M3.646 9.146a.5.5 0 0 1 .708 0L8 12.793l3.646-3.647a.5.5 0 0 1 .708.708l-4 4a.5.5 0 0 1-.708 0l-4-4a.5.5 0 0 1 0-.708m0-2.292a.5.5 0 0 0 .708 0L8 3.207l3.646 3.647a.5.5 0 0 0 .708-.708l-4-4a.5.5 0 0 0-.708 0l-4 4a.5.5 0 0 0 0 .708"/></svg>
          <ul class="place-list" id={`${p.key}-list`} role="listbox" hidden></ul>
        </div>
      ))}
      <label class="field field--dates">
        <span class="field__label">{ui.dates}</span>
        <input type="text" id="dates" name="dates" placeholder={ui.datesPlaceholder}>
      </label>
      <button class="search__btn" type="submit">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15.5 14h-.79l-.28-.27A6.47 6.47 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
        {ui.search}
      </button>
    </form>

    <ul class="hero__badges">
      {ui.badges.map((b) => <li>{b}</li>)}
    </ul>
  </div>
</section>
