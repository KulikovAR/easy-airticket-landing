---
import { postPath } from '../data/routes';
import { t } from '../data/site';
import type { Lang } from '../data/i18n';
import type { Post } from '../data/posts';

interface Props { post: Post; lang: Lang }
const { post, lang } = Astro.props;
const ui = t(lang);
const text = post[lang]!;
const live = Boolean(text.slug && text.body);
const PLANE = 'M21 16v-2l-8-5V3.5a1.5 1.5 0 0 0-3 0V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z';
const ART = {
  ticket: 'M22 10V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v4a2 2 0 1 1 0 4v4a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-4a2 2 0 1 1 0-4zm-9 7.5h-2v-2h2v2zm0-4.5h-2v-2h2v2zm0-4.5h-2v-2h2v2z',
  compare: 'M9.01 14H2v2h7.01v3L13 15l-3.99-4v3zm5.98-1v-3H22V8h-7.01V5L11 9l3.99 4z',
  pnr: 'M19 3h-4.18A3 3 0 0 0 12 1a3 3 0 0 0-2.82 2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2zm-7 0a1 1 0 1 1 0 2 1 1 0 0 1 0-2zm-2 14-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z',
};
const Tag = live ? 'a' : 'article';
---
<Tag class:list={['post', 'reveal', { 'post--soon': !live }]} href={live ? postPath(post, lang) : undefined}>
  <div class={`post__thumb post__thumb--${post.theme}`} aria-hidden="true">
    <div class="post__art"><svg viewBox="0 0 24 24"><path d={ART[post.art]}/></svg></div>
    <span class="post__more"><span>{live ? ui.readMore : ui.comingSoon}</span></span>
  </div>
  <h3 class="post__title">{text.title}</h3>
  <div class="post__meta">
    <span class="post__author"><span class="post__avatar" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={PLANE}/></svg></span>{ui.author}</span>
    {live && post.date ? <time datetime={post.date}>{text.dateLabel}</time> : <span class="post__soon">{ui.comingSoon}</span>}
  </div>
</Tag>
