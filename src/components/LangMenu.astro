---
import { langInfo, languages, url, type Lang } from '../data/i18n';
import { t } from '../data/site';

interface Props { lang: Lang; alternates: Partial<Record<Lang, string>> }
const { lang, alternates } = Astro.props;
const ui = t(lang);
// Link to the same page in another language when it exists, otherwise to that language's home page.
const hrefFor = (code: Lang) => alternates[code] ?? url(code);
---
<details class="lang">
  <summary aria-label={ui.langLabel}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm6.93 6h-2.95a15.65 15.65 0 0 0-1.38-3.56A8.03 8.03 0 0 1 18.93 8zM12 4.04c.83 1.2 1.48 2.53 1.91 3.96h-3.82c.43-1.43 1.08-2.76 1.91-3.96zM4.26 14a8.2 8.2 0 0 1 0-4h3.38a16.5 16.5 0 0 0 0 4H4.26zm.81 2h2.95c.32 1.25.78 2.45 1.38 3.56A7.99 7.99 0 0 1 5.07 16zm2.95-8H5.07a7.99 7.99 0 0 1 4.33-3.56A15.65 15.65 0 0 0 8.02 8zM12 19.96c-.83-1.2-1.48-2.53-1.91-3.96h3.82c-.43 1.43-1.08 2.76-1.91 3.96zM14.34 14H9.66a14.7 14.7 0 0 1 0-4h4.68a14.7 14.7 0 0 1 0 4zm.25 5.56c.6-1.11 1.06-2.31 1.38-3.56h2.95a8.03 8.03 0 0 1-4.33 3.56zM16.36 14a16.5 16.5 0 0 0 0-4h3.38a8.2 8.2 0 0 1 0 4h-3.38z"/></svg>
    <span>{langInfo(lang).short}</span>
    <svg class="lang__caret" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 10l5 5 5-5z"/></svg>
  </summary>
  <nav aria-label={ui.langLabel}>
    <ul class="lang__menu">
      {languages.map((l) => (
        <li>
          {l.enabled ? (
            <a href={hrefFor(l.code)} hreflang={l.hreflang} lang={l.htmlLang} aria-current={l.code === lang ? 'true' : undefined}>{l.label}</a>
          ) : (
            <span class="lang__soon" lang={l.htmlLang}>{l.label} <small>{ui.soon}</small></span>
          )}
        </li>
      ))}
    </ul>
  </nav>
</details>
